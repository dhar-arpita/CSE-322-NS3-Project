# Smooth spline
def smooth(x, y):
    x, y = np.array(x, dtype=float), np.array(y, dtype=float)
    xnew = np.linspace(x.min(), x.max(), 200)
    return xnew, make_interp_spline(x, y, k=3)(xnew)

# Single graph generator
def make_graph(attacks, styles, metric, ylabel, title, filename, ylim=None):
    fig, ax = plt.subplots(figsize=(8, 5.5))
    for atk in attacks:
        s, d = styles[atk], data[atk]
        xs, ys = smooth(d['speed'], d[metric])
        ax.plot(xs, ys, color=s['color'], linestyle='--', linewidth=2, label=s['label'])
        ax.plot(d['speed'], d[metric], color=s['color'], marker=s['marker'],
                markersize=9, linewidth=0, markeredgecolor='white', markeredgewidth=1.2, zorder=5)
    ax.set_xlabel('Mobility Speed (m/s)', fontsize=12, fontweight='bold')
    ax.set_ylabel(ylabel, fontsize=12, fontweight='bold')
    ax.set_title(title, fontsize=13, fontweight='bold', pad=12)
    ax.legend(fontsize=10, loc='best', framealpha=0.9)
    ax.grid(True, alpha=0.25)
    ax.set_xticks([0, 5, 10, 15, 20])
    if ylim: ax.set_ylim(ylim)
    ax.spines['top'].set_visible(False)
    ax.spines['right'].set_visible(False)
    fig.tight_layout()
    fig.savefig(filename, dpi=150, bbox_inches='tight')
    plt.close(fig)
    print(f"Saved: {filename}")

